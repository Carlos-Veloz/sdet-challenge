{
  "name": "sdet-user-management-api-tests",
  "version": "1.0.0",
  "description": "E2E API test suite (Playwright + TypeScript) for the User Management API SDET challenge",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:dev": "playwright test --project=dev",
    "test:prod": "playwright test --project=prod",
    "test:contract": "playwright test --grep @contract",
    "test:auth": "playwright test --grep @auth",
    "report": "playwright show-report",
    "failures": "ts-node scripts/failures-summary.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^5.4.3",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
